---
import { Image } from 'astro:assets';
import p000 from '../assets/stills/p000.png';
import { site } from '../content/site';
---

<section class="hero wrap" aria-labelledby="wordmark">
  <span class="index">(01)</span>
  <h1 id="wordmark" class="wordmark">
    <span class="line">Project</span> <span class="line">Win</span>
  </h1>
  <p class="hero-line">{site.hero.line}</p>
  <Image
    class="hero-still"
    src={p000}
    alt=""
    data-still="p000"
    widths={[480, 960, 1280]}
    sizes="(max-width: 760px) 100vw, 44vw"
    format="webp"
    loading="lazy"
  />
</section>
